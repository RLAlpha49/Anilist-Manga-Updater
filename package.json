{
  "name": "kenmei-to-anilist",
  "productName": "Kenmei to Anilist",
  "version": "3.0.0",
  "description": "Kenmei to Anilist",
  "main": ".vite/build/main.js",
  "type": "commonjs",
  "private": true,
  "config": {
    "forge": "config/forge.config.js"
  },
  "scripts": {
    "commitlint": "commitlint --edit",
    "docs": "typedoc --options config/typedoc.json",
    "format:write": "prettier --write .",
    "lint": "eslint -c eslint.config.mjs .",
    "make": "node build.js",
    "typecheck": "tsc --noEmit",
    "make:dev": "cross-env NODE_ENV=development electron-forge make",
    "precommit": "npm run format:write && npm run lint",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "start": "electron-forge start",
    "update": "ncu -u -x typedoc,typedoc-*,@typedoc/*",
    "analyze:bundle": "cross-env ANALYZE=true vite build --config config/vite.renderer.config.mts"
  },
  "author": "Alex Pettigrew <alexpettigrew29@gmail.com>",
  "license": "MIT",
